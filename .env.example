# MAFA Environment Configuration
# Copy this file to .env and fill in with your values
# .env is NOT committed to git for security

# ============================================================================
# Model Configuration
# ============================================================================

# Path to the fine-tuned Phi-3 model
LLM_MODEL_PATH=./models/phi_3

# Path to ChromaDB vector store
CHROMADB_PATH=./data/chromadb

# Device: cuda or cpu
DEVICE=cuda

# Load model in 4-bit quantization (true/false)
LOAD_IN_4BIT=true

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# API Keys (if needed for external services)
# ============================================================================

# Hugging Face Hub token (for downloading models)
# HF_TOKEN=your_token_here

# ============================================================================
# Gradio Configuration (UI)
# ============================================================================

# Gradio server port
GRADIO_SERVER_PORT=7860

# Allow external connections
GRADIO_SERVER_NAME=0.0.0.0

# ============================================================================
# Development
# ============================================================================

# Debug mode
DEBUG=false
